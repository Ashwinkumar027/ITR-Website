// Simple redirect message component for ITR Filing
import { useEffect } from 'react';
import './ITRFiling.css';

const ITRFiling = () => {
    const ITR_APP_URL = 'http://localhost:3001'; // Your ITR project will run here

    useEffect(() => {
        // Optionally auto-redirect after 3 seconds
        // const timer = setTimeout(() => {
        //     window.location.href = ITR_APP_URL;
        // }, 3000);
        // return () => clearTimeout(timer);
    }, []);

    const handleRedirect = () => {
        window.open(ITR_APP_URL, '_self');
    };

    return (
        <div className="itr-filing-page">
            {/* Page Hero */}
            <section className="page-hero">
                <div className="container">
                    <div className="page-hero-content">
                        <h1 className="page-title">File Your Income Tax Return Online</h1>
                        <p className="page-subtitle">
                            Complete your ITR filing in minutes with CA verified accuracy
                        </p>
                    </div>
                </div>
            </section>

            {/* ITR Form Redirect */}
            <section className="filing-section">
                <div className="container">
                    <div className="redirect-container">
                        <div className="redirect-card">
                            <div className="redirect-icon">
                                <svg width="100" height="100" viewBox="0 0 100 100" fill="none">
                                    <circle cx="50" cy="50" r="45" fill="#EEF2FF" />
                                    <path d="M40 50L50 60L70 40" stroke="#0066FF" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" />
                                    <path d="M50 25V35M50 65V75M25 50H35M65 50H75" stroke="#0066FF" strokeWidth="3" strokeLinecap="round" />
                                </svg>
                            </div>
                            <h2 className="redirect-title">Ready to File Your ITR?</h2>
                            <p className="redirect-description">
                                Click the button below to start your income tax return filing process. 
                                You'll be redirected to our secure ITR filing portal.
                            </p>
                            <div className="redirect-features">
                                <div className="feature-item">
                                    <span className="feature-icon">✓</span>
                                    <span>CA Verified Filing</span>
                                </div>
                                <div className="feature-item">
                                    <span className="feature-icon">✓</span>
                                    <span>Secure & Encrypted</span>
                                </div>
                                <div className="feature-item">
                                    <span className="feature-icon">✓</span>
                                    <span>Quick Processing</span>
                                </div>
                                <div className="feature-item">
                                    <span className="feature-icon">✓</span>
                                    <span>Expert Support</span>
                                </div>
                            </div>
                            <button className="btn btn-primary btn-lg redirect-button" onClick={handleRedirect}>
                                <span>Start ITR Filing</span>
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                    <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
                                </svg>
                            </button>
                            <p className="redirect-note">
                                <span className="note-icon">ℹ️</span>
                                Make sure your ITR filing portal is running on port 3001
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    );
};

export default ITRFiling;
